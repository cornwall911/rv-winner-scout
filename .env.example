# ==================================================
# RV Winner Scout Configuration Template
# ==================================================

# AI Provider Settings
# AI_PROVIDER options: gemini | tokenrouter
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
AI_API_KEY=your_gemini_api_key_here

# TokenRouter Settings (Alternative / Failover)
TOKENROUTER_API_KEY=sk-EZKfB572Cl7RcLffHgrEAGLCXORyRr9HVtnh9wVhUo9fs6Ix
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_MODEL=z-ai/glm-5.3-free

# Google Sheets Configuration
SPREADSHEET_ID=your_google_spreadsheet_id_here
SHEET_NAME=RV Research
# Either path to service account json file OR raw json string OR base64-encoded json
GOOGLE_SHEETS_CREDENTIALS_JSON=

# Operational & Safety Controls
RUN_MODE=smoke                  # smoke (5-10 items) | small (15-30 items) | full (all accessible)
MAX_PRODUCTS_PER_RUN=10
GLOBAL_DEADLINE_MINUTES=45
HTTP_TIMEOUT_SECONDS=20
MAX_RETRIES=3
POLITE_DELAY_MIN_SECONDS=2.0
POLITE_DELAY_MAX_SECONDS=5.0
CIRCUIT_BREAKER_FAILURES=3
CIRCUIT_BREAKER_RESET_SECONDS=600

# Persistence & Logging
DATA_DIR=data
LOG_LEVEL=INFO
ENABLE_HTML_SNAPSHOTS=true

# Benchmark
REFERENCE_WINNER_URL=https://www.amazon.com/dp/B0EXAMPLE
